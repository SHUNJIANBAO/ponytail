{
  "name": "dsh-ponytail",
  "version": "1.0.0",
  "description": "ponytail（懒散资深工程师模式）：任何编码任务动手前自动加载的最简方案约束，默认 full 档。随包分发 ponytail / ponytail-review / ponytail-audit 三个技能。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "skill",
    "ponytail",
    "yagni"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SHUNJIANBAO/dsh-ponytail.git"
  }
}
